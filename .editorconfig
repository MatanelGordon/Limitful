root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,py,rs}]
indent_style = space
indent_size = 4

[*.go]
indent_style = tab
indent_size = 4

[*.{json,jsonc,md,toml,yaml,yml}]
indent_style = space
indent_size = 2

[*.{csproj,props,slnx,targets}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
