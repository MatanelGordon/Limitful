{
  "name": "limitful",
  "version": "0.0.0",
  "description": "Limitful load-leveling utilities — TypeScript implementation",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MatanelGordon/Limitful.git",
    "directory": "typescript/main"
  },
  "homepage": "https://github.com/MatanelGordon/Limitful#readme",
  "bugs": {
    "url": "https://github.com/MatanelGordon/Limitful/issues"
  },
  "keywords": [
    "rate-limiting",
    "load-leveling",
    "concurrency"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "vitest run --no-coverage",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "clean": "rm -rf dist",
    "ci": "tsc --noEmit && vitest run --no-coverage && prettier --check \"src/**/*.ts\""
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
